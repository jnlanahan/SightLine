{
  "name": "sightline",
  "version": "0.1.0",
  "description": "AI-powered real-time tech support assistant that watches your screen and guides you step by step.",
  "main": "dist-electron/main.mjs",
  "author": "SightLine",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-electron.js && concurrently -k -n VITE,ELECTRON -c cyan,yellow \"vite\" \"wait-on tcp:5173 && node scripts/run-electron.js\"",
    "build": "vite build && node scripts/build-electron.js",
    "preview": "vite preview",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@google-cloud/text-to-speech": "^6.4.1",
    "koffi": "^3.1.0",
    "openai": "^4.67.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uiohook-napi": "^1.5.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^42.1.0",
    "electron-builder": "^25.0.5",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^4.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.sightline.app",
    "productName": "SightLine",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
